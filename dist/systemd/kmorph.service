[Unit]
Description=Arm a kmorph successor kernel
After=local-fs.target
ConditionPathExists=/etc/kmorph/kmorph.conf

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/lib/kmorph/kmorph-mkimage --if-stale
ExecStart=/usr/bin/kmorph arm
ExecStop=/usr/bin/kmorph disarm

[Install]
WantedBy=multi-user.target

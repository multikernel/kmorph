[Unit]
Description=Arm a kmorph successor kernel and keep its network identity current
After=local-fs.target
ConditionPathExists=/etc/kmorph/kmorph.conf

[Service]
ExecStartPre=/usr/lib/kmorph/kmorph-mkimage --if-stale
ExecStartPre=/usr/bin/kmorph arm
ExecStart=/usr/bin/kmorph watch
ExecStop=/usr/bin/kmorph disarm

[Install]
WantedBy=multi-user.target

# The image is read-only; standby services get a writable copy of its /var.
[Unit]
Description=Writable /var for the kmorph standby
DefaultDependencies=no
Before=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'mkdir -p /run/kmorph/var && cp -a /var/. /run/kmorph/var/ && mount --bind /run/kmorph/var /var && mount -t tmpfs -o mode=1777 tmpfs /tmp'

[Install]
WantedBy=local-fs.target

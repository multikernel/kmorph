#!/bin/sh
# Start kmorphd before the root device is looked for, and wait here for
# the takeover: the root device can appear before it is done, the
# predecessor's disk being adopted first, and the boot must not reach
# the real init with kmorphd mid-takeover.
PREREQ="udev"
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs) prereqs; exit 0 ;;
esac

[ -x /usr/bin/kmorphd ] || exit 0
[ -d /proc/device-tree/chosen/multikernel,host-tree ] || exit 0

. /scripts/functions
log_begin_msg "Waiting for the kmorph takeover"
/usr/bin/kmorphd --wait || panic "kmorphd stopped before the takeover"
log_end_msg
exit 0

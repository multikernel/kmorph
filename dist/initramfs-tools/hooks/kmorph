#!/bin/sh
# initramfs-tools hook: kmorphd and its config into the image, only
# when kmorph-mkimage is building the successor's; the host's own
# images are left alone.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs) prereqs; exit 0 ;;
esac

[ "$KMORPH_IMAGE" = 1 ] || exit 0

. /usr/share/initramfs-tools/hook-functions

conf=${KMORPH_CONF:-/etc/kmorph/kmorph.conf}
copy_exec /usr/bin/kmorphd /usr/bin
if [ -f "$conf" ]; then
	mkdir -p "$DESTDIR/etc/kmorph"
	copy_file config "$conf" /etc/kmorph/kmorph.conf
	# Modules the config asks for: the vsock transport when it is one,
	# drivers for devices handed to the successor.
	mods=$(sed -n 's/^modules[[:space:]]*=[[:space:]]*//p' "$conf" | tr ',' ' ')
	if [ -n "$mods" ]; then
		manual_add_modules $mods
	fi
fi

#!/bin/sh
# initramfs-tools hook: kmorphd and its config into the image, only
# when kmorph-mkimage is building the successor's; the host's own
# images are left alone.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs) prereqs; exit 0 ;;
esac

[ "$KMORPH_IMAGE" = 1 ] || exit 0

. /usr/share/initramfs-tools/hook-functions

copy_exec /usr/bin/kmorphd /usr/bin
if [ -f /etc/kmorph/kmorph.conf ]; then
	mkdir -p "$DESTDIR/etc/kmorph"
	copy_file config /etc/kmorph/kmorph.conf /etc/kmorph/kmorph.conf
fi

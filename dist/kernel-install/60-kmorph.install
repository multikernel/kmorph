#!/bin/bash
# Point the kmorph config at the kernel just installed and rebuild the
# successor image for it, so the successor keeps up with kernel updates
# and the next arm need not build the image itself. Runs as a
# kernel-install plugin (add|remove VERSION ...) and as a Debian kernel
# postinst hook (VERSION IMAGE). Only the kernel key
# is touched; the rest is the operator's.
CONF=/etc/kmorph/kmorph.conf

case "$1" in
add) KERNEL_VERSION="$2" ;;
remove) exit 0 ;;
*) KERNEL_VERSION="$1" ;;
esac

[ -n "$KERNEL_VERSION" ] || exit 0
[ -f "$CONF" ] || exit 0

KERNEL="/boot/vmlinuz-$KERNEL_VERSION"
[ -f "$KERNEL" ] || exit 0

set_key() {
	if grep -q "^$1[[:space:]]*=" "$CONF"; then
		sed -i "s|^$1[[:space:]]*=.*|$1 = $2|" "$CONF"
	else
		printf '%s = %s\n' "$1" "$2" >> "$CONF"
	fi
}

set_key kernel "$KERNEL"
exec /usr/bin/kmorph image

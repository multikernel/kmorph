#!/bin/bash
# Rebuild the successor image for the kernel just installed and point
# the kmorph config at it, so the successor keeps up with kernel
# updates. Runs as a kernel-install plugin (add|remove VERSION ...) and
# as a Debian kernel postinst hook (VERSION IMAGE). Only the kernel key
# is touched; the rest is the operator's.
CONF=/etc/kmorph/kmorph.conf

case "$1" in
add) KERNEL_VERSION="$2" ;;
remove) exit 0 ;;
*) KERNEL_VERSION="$1" ;;
esac

[ -n "$KERNEL_VERSION" ] || exit 0
[ -f "$CONF" ] || exit 0

KERNEL="/boot/vmlinuz-$KERNEL_VERSION"
[ -f "$KERNEL" ] || exit 0

set_key() {
	if grep -q "^$1[[:space:]]*=" "$CONF"; then
		sed -i "s|^$1[[:space:]]*=.*|$1 = $2|" "$CONF"
	else
		printf '%s = %s\n' "$1" "$2" >> "$CONF"
	fi
}

set_key kernel "$KERNEL"
exec /usr/lib/kmorph/kmorph-mkimage "$KERNEL_VERSION"
